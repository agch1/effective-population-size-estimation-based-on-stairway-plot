# 8. Función de Remuestreo: Bootstrap

```{r, echo=TRUE}
bootstrap_SFS <- function(SFS_obs, n_bootstrap = 1000) {
  bootstrap_results <- matrix(0, nrow = n_bootstrap, ncol = length(SFS_obs))
  for (b in 1:n_bootstrap) {
    bootstrap_sample <- sample(c(1:(n-1)), size = sum(SFS_obs), replace = TRUE, prob=SFS_obs)
    bootstrap_sample_ <- NULL
    for(i in c(1:(n-1)))
      bootstrap_sample_ <- cbind(bootstrap_sample_,sum(bootstrap_sample==i))
    bootstrap_results[b, ] <- bootstrap_sample_
  }
  return(bootstrap_results)
}
bootstrap_results <- bootstrap_SFS(SFS_obs, n_bootstrap = 1000)
```

