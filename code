## - Logaritmo de likelihood:
```{r, echo=TRUE}
log_likelihood <- function(SFS_obs, n, mu, theta_values,L) {
  #calcular p_i
  p_i <- array(0,dim=c(n)) 
  #los valores de i se desplazan uno en el array para guardar i=0 
  for(i in c(1:n-1)) {
    p_i[i+1] <- P_i(i, n, mu, theta_values)
  }
  #calular el valor de p_i para i=0
  p_i[1] <- 1 - sum(p_i)
  if(p_i[1]<0) return(-1e9)
  
  # Calcular la log-verosimilitud
  SFS_o <- c(L-sum(SFS_obs),SFS_obs) #añadir las posiciones con no variantes (i=0) en el primer valor del array
  Lm <- lfactorial(L)
  for(i in c(1:n)) {
    Lm <- Lm + log(p_i[i]) * SFS_o[i] - lfactorial(SFS_o[i])
  }
  if(is.na(Lm) || is.infinite(Lm)) 
    return(-1e9)
  return(Lm)
}

