# 3. Optimización de theta
```{r, echo=TRUE}
# Función de optimización para theta
optimize_theta <- function(SFS_obs, n, mu, theta_range, L) {
  
  theta_values <- runif(n=length(SFS_obs),min=min(theta_range),max=max(theta_range))
  objective_function <- function(theta_values) {
    log_likelihood(SFS_obs, n, mu, theta_values, L)
  }
  
  result <- optim(
    par = theta_values,
    fn = objective_function,
    method = "L-BFGS-B",
    lower = rep(min(theta_range), length(SFS_obs)),  # Límite inferior
    upper = rep(max(theta_range), length(SFS_obs)),  # Límite superior
    control = list(fnscale = -1)  #Maximizar la log-verosimilitud
  )
  
  return(result)
}

result <- optimize_theta(SFS_obs=SFS_obs, n=n, mu=mu,theta_range=c(1e-5,1e-1), L=L)
print(result)
