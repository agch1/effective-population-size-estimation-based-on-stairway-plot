# 5. Cálculo del tiempo esperado de coalescencia (Ti)

```{r, echo=TRUE}
# Función para calcular Ti
calculate_Ti <- function(n, theta_values) {
  Ti_values <- numeric(n - 1)
  for (i in 2:n) {
    #suma de thetak/(k*(k-1)) desde k=i hasta k=n
    for(j in i:n) {
      Ti_values[i - 1] <- Ti_values[i - 1] + theta_values[j-1]/(j*(j-1))
    }
  }
  return(Ti_values)
}

