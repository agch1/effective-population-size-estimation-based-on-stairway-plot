## - Probabilidad de coalescencia:
```{r, echo=TRUE}
# función para calcular el coeficiente binomial
lbinomial <- function(n, k) {
  if (k > n || k < 0) return(0)
  return(lchoose(n, k))
}
#check
lbinomial(5,2)

# Función para calcular probabilidad combinatoria
P_ki <- function(k, i, n) {
  if (k < 2 || k > (n - i + 1) || n <= i || i < 1) {
    return(0)
  }
  return(exp(lbinomial(n - i - 1, k - 2) - lbinomial(n - 1, k - 1)))
}
#check
P_ki(2,1,10)
#choose(10 - 1 - 1, 2 - 2)/choose(10 - 1, 2 - 1)

P_i <- function(i, n, mu, theta_values) {
  Pi_value <- 0
  #ajusta el rango a partir de i=1
  if (i > 0) {
    for (k in 2:(n - i + 1)) {
      prob <- P_ki(k, i, n)
      if (is.finite(prob) && prob > 0) {
        #Fórmula de Pi
        Pi_value <- Pi_value + (k * prob * (theta_values[k-1] / (k * (k - 1))))
      } else {
        # Aviso si la probabilidad no es válida
        print(paste("Warning: Invalid probability for k =", k, "i =", i))
      }
    }
  }
  return(Pi_value)
}

