y_values <- numeric(length(x_values))

for (i in 1:length(x_values)) {
  t <- x_values[i]
  
  for (epoch in epoch_changes) {
    if (t >= epoch$time) {
      N_ratio <- epoch$N_ratio
    } else {
      break
    }
  }
  
  if (t < 2500) {
    y_values[i] <- Ne 
  } else if (t >= 2500 && t < 5000) {
    y_values[i] <- Ne * N_ratio 
  } else if (t >= 5000 && t < 7500) {
    y_values[i] <- Ne * N_ratio
  } else if (t >= 7500 && t < 10000) {
    y_values[i] <- Ne * N_ratio
  } else {
    y_values[i] <- Ne
  }
}
