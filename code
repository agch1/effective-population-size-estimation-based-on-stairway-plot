# 6. Cálculo de SFS esperado bajo diferentes modelos demográficos
```{r, echo=TRUE}
library(reticulate)
#for macOS uncomment this 2 next rows. Otherwise comment!
#path_to_python <- "/opt/miniconda3/python.app/Contents/MacOS/python"
#use_python(path_to_python)
msprime <- import("msprime")

simulate_SFS <- function(n, model = "stationary", params = list(), reps = 1, L=1e6, recombination_rate = 1e-6, mutation_rate = 1e-7, Ne=1e4) {
  
  n <- as.integer(n)
  SFS_simulated <- matrix(0, nrow = reps, ncol = n - 1)

  for (r in 1:reps) {
    simulation <- NULL
    
    #SFS según el modelo
    if (model == "stationary") {
      simulation <- msprime$simulate(
        sample_size = n,
        length = L,
        recombination_rate = recombination_rate,
        mutation_rate = mutation_rate,
        Ne = Ne
      )
    } else if (model == "two_epochs") {
      T_change <- params$T_change
      N_ratio <- params$N_ratio
      population_configurations = list(
        msprime$PopulationConfiguration(initial_size = Ne, sample_size = n)
      )
      demographic_events = list(
        msprime$PopulationParametersChange(
          time = T_change,
          initial_size = Ne * N_ratio,
          population = as.integer(0)
       )
      )
      simulation <- msprime$simulate(
        length = L,
        recombination_rate = recombination_rate,
        mutation_rate = mutation_rate,
        population_configurations = population_configurations,
        demographic_events = demographic_events
      )
    } else if (model == "bottleneck") {
      T_bottleneck <- params$T_bottleneck
      N_bottleneck_ratio <- params$N_bottleneck_ratio
      T_recovery <- params$T_recovery
      population_configurations = list(
        msprime$PopulationConfiguration(initial_size = Ne, sample_size = n)
      )
      demographic_events = list(
        msprime$PopulationParametersChange(
          time = T_bottleneck,
          initial_size = N_bottleneck_ratio * Ne,
          population = as.integer(0)
        ),
        msprime$PopulationParametersChange(
          time = T_recovery,
          initial_size = Ne,
          population = as.integer(0)
        )
      )
      simulation <- msprime$simulate(
        length = L,
        recombination_rate = recombination_rate,
        mutation_rate = mutation_rate,
        population_configurations = population_configurations,
        demographic_events = demographic_events
      )
    } else if (model == "migration_one_direction") {
      m_rate <- params$m_rate
      N1 <- params$N1
      N2 <- params$N2
      population_configurations = list(
        msprime$PopulationConfiguration(initial_size = N1, sample_size = as.integer(n / 2)),  
       msprime$PopulationConfiguration(initial_size = N2, sample_size = as.integer(n / 2))
     )
     migration_matrix = list(
       list(0, 0),
       list(m_rate, 0)
     )
     simulation <- msprime$simulate(
        length = L,
        recombination_rate = recombination_rate,
        mutation_rate = mutation_rate,
        population_configurations = population_configurations,
        migration_matrix = migration_matrix
      )
    } else if (model == "multi_epoch") {
      epoch_changes <- params$epoch_changes
      population_configurations = list(
        msprime$PopulationConfiguration(initial_size = Ne, sample_size = n)
      )
      demographic_events = lapply(epoch_changes, function(change) {
        msprime$PopulationParametersChange(
          time = change$time,
          initial_size = change$N_ratio * Ne,
          population = as.integer(0)
        )
      })
      simulation <- msprime$simulate(
        length = L,
        recombination_rate = recombination_rate,
        mutation_rate = mutation_rate,
        population_configurations = population_configurations,
        demographic_events = demographic_events
     )
    } else {
      stop("Modelo no reconocido")
    }

    sfs <- simulation$allele_frequency_spectrum(mode = "site", polarised=TRUE)
    sfs <- as.numeric(sfs[2:n])
    sfs <- sfs * L
    SFS_simulated[r, ] <- sfs
  }
  return(colMeans(SFS_simulated))
}
```

